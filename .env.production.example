# ------------------------------------------------------------
# Production secrets for the Hugging Face Space. Copy to .env.production (gitignored), fill in,
# then: .venv\Scripts\python scripts\deploy_space.py <hf-user>/retainiq
# Every value is stored as an encrypted Space Secret; nothing here is uploaded as a file.
# ------------------------------------------------------------

# AMD Token Factory (the LLM)
LLM_PROVIDER=token_factory
LLM_API_KEY=rc-paste-your-team-key-here

# Neon PostgreSQL: Dashboard -> your project -> Connect -> copy the connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# NEW long random value - never reuse the local one:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Your admin login (NEW password, 12+ characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# One-click demo account for judges (role "demo", 40 AI calls a day)
DEMO_EMAIL=demo@retainiq.app
DEMO_PASSWORD=

# Behind HTTPS: always send cookies as Secure
COOKIE_SECURE=true

# Optional
# DAILY_AI_CALLS_ADMIN=500
# DAILY_AI_CALLS_ANALYST=150
# DAILY_AI_CALLS_DEMO=40
# LLM_TRANSCRIBE_MODEL=        # voice stays off: Token Factory doesn't accept audio yet
