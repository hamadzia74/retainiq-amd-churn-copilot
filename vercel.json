{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci --no-audit --no-fund && npm run build",
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "excludeFiles": "{frontend/node_modules/**,frontend/src/**,tests/**,docs/**,data/**,scripts/**,**/__pycache__/**,PROMPT*.md,Dockerfile,docker-compose.yml}"
    }
  }
}
