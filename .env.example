# ------------------------------------------------------------
# RetainIQ LLM settings. Copy to .env (gitignored) and fill in.
# Pick a profile; every LLM_* value below is optional and overrides it.
# ------------------------------------------------------------

# Option A (default): AMD Token Factory - free shared endpoints on AMD GPUs.
#   Get the team key at https://notebooks.amd.com/tokenfactory (AMD AI Developer Program login).
LLM_PROVIDER=token_factory
LLM_API_KEY=rc-paste-your-team-key-here

# Option B: your own vLLM on an AMD Instinct MI300X (AMD Developer Cloud, ROCm).
#   Start it with scripts/serve_amd.sh, tunnel port 8000, then:
# LLM_PROVIDER=vllm
# LLM_API_KEY=EMPTY

# Optional overrides
# LLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# LLM_MODEL=DeepSeek-V4-Flash
# LLM_HARDWARE=AMD Token Factory · AMD GPUs
# LLM_CONCURRENCY=7       # parallel requests (Token Factory allows 8 per key)
# LLM_RPM=18              # requests per minute, 0 = unlimited (Token Factory allows 20)
# LLM_BATCH_SIZE=50       # tickets/reviews per enrichment request
