# ------------------------------------------------------------
# RetainIQ LLM settings. Copy to .env (gitignored) and fill in.
# Pick a profile; every LLM_* value below is optional and overrides it.
# ------------------------------------------------------------

# Option A (default): AMD Token Factory - free shared endpoints on AMD GPUs.
#   Get the team key at https://notebooks.amd.com/tokenfactory (AMD AI Developer Program login).
LLM_PROVIDER=token_factory
LLM_API_KEY=rc-paste-your-team-key-here

# Option B: your own vLLM on an AMD Instinct MI300X (AMD Developer Cloud, ROCm).
#   Start it with scripts/serve_amd.sh, tunnel port 8000, then:
# LLM_PROVIDER=vllm
# LLM_API_KEY=EMPTY

# Optional overrides
# LLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# LLM_MODEL=DeepSeek-V4-Flash
# LLM_HARDWARE=AMD Token Factory · AMD GPUs
# LLM_CONCURRENCY=7       # parallel requests (Token Factory allows 8 per key)
# LLM_RPM=18              # requests per minute, 0 = unlimited (Token Factory allows 20)
# LLM_BATCH_SIZE=50       # tickets/reviews per enrichment request

# ------------------------------------------------------------
# Web app: database, sign-in and daily AI limits (api/settings.py)
# ------------------------------------------------------------
# PostgreSQL. The default matches docker-compose.yml (docker compose up -d db).
# DATABASE_URL=postgresql://retainiq:retainiq@localhost:5433/retainiq

# The first admin, created at startup if missing.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-please
# ADMIN_NAME=Your Name

# Signs session cookies. Set a long random value in production
# (python -c "import secrets; print(secrets.token_urlsafe(48))"); unset = generated into data/.jwt_secret.
# JWT_SECRET=

# Optional one-click demo account for judges (role "demo", small daily AI allowance).
# DEMO_EMAIL=demo@example.com
# DEMO_PASSWORD=demo-password

# ALLOW_SIGNUP=false           # true = anyone can create an analyst account
# DAILY_AI_CALLS_ADMIN=500
# DAILY_AI_CALLS_ANALYST=150
# DAILY_AI_CALLS_DEMO=40
# SESSION_DAYS=7
# COOKIE_SECURE=false          # forced on automatically for HTTPS requests
